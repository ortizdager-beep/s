# Puerto del backend
PORT=4000

# Secreto para firmar la cookie de sesión (cambiar en producción)
SESSION_SECRET=cambia-este-secreto-en-produccion

# URL del frontend (para CORS)
CLIENT_ORIGIN=http://localhost:5173

# Destinatario del email al enviar una plantilla
EMAIL_DESTINO=destino@empresa.com

# Configuración SMTP (opcional). Si se dejan vacías, el servidor usa
# una cuenta de prueba Ethereal automática y muestra un link de vista previa
# en la consola, para que el prototipo funcione sin credenciales reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plantillas Ops <no-reply@empresa.com>"
